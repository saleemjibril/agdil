ainer */
.test .elementor-testimonial {
    background-color: #f5f7fc !important; /* Light background */
    border-radius: 10px !important;
    border: 1px solid #28a745 !important; /* Green border around card */
    padding: 30px !important;
    max-width: 900px !important; /* Increased width for the testimonial */
