.test .elementor-swiper-button {
    background-color: #0073e6 !important;
    color: #fff !important;
    padding: 10px !important;
    border-radius: 50% !important;
    position: relative !important; /* Adjust for positioning below the card */
    display: inline-block !important;
    margin: 10px 5px !important; /* Space between the two arrows */
}

.test .elementor-swiper-button-prev {
    order: -1 !important; /* Ensure left arrow appears before the right */
}

