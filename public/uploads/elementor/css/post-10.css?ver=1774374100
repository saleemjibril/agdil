    justify-content: space-between !important;
    align-items: center !important;
}

/* Adjust the testimonial text */
.test .elementor-testimonial__text {
    font-size: 18px !important;
    color: #333 !important;
    font-style: italic !important;
    line-height: 1.5 !important;
    flex-grow: 1 !important;
    margin-right: 20px !important; /* Space between text and image */
}

/* Style the image and move it to the right */
.test .elementor-testimonial__image {
    order: 1 !important; /* Move image to the right */
}

.elementor-testimonial__image img {
    border-radius: 10px !important; /* Slightly rounded image corners */
    width: 100% !important; /* Increased image size */
    height: 100% !important;
    object-fit: cover !important;
    border: 1px solid #ddd !important; /* Subtle border */
}

/* Style the testimonial footer (name and image section) */
.elementor-testimonial__footer {
    display: flex !important;
    flex-direction: column !important;
    text-align: left !important;
}

/* Style the name and title inside the cite */
.elementor-testimonial__cite {
    margin-top: 10px !important;
}

.elementor-testimonial__cite .elementor-testimonial__name {
    font-size: 16px !important;
    font-weight: bold !important;
    color: #0073e6 !important;
}

.elementor-testimonial__cite .elementor-testimonial__title {
    font-size: 14px !important;
    color: #999 !important;
}

/* Remove pagination dots */
.test .swiper-pagination {
    display: none !important; /* Hides pagination dots */
}

