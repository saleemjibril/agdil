.custom-confirmation {
    width: 100%; /* Full width */
    max-width: 100%; /* Ensures it doesn't shrink */
    padding: 40px 10%; /* Adds breathing room on the sides */
    background: #fff;
    box-sizing: border-box;
    font-family: 'Arial', sans-serif;
    color: #333;
    text-align: center;
}

/* Style the main heading */
.custom-confirmation h2 {
    color: #006400;
    font-size: 28px;
    font-weight: bold;
    margin-bottom: 20px;
}

/* Style section headings */
.custom-confirmation h3 {
    color: #0054a6;
    font-size: 22px;
    margin: 30px 0 10px;
    padding-bottom: 8px;
    border-bottom: 2px solid #ddd;
}

/* Score and warning messages */
.custom-confirmation p {
    font-size: 18px;
    margin: 15px 0;
    line-height: 1.6;
}

/* Make key scores and warnings bold */
.custom-confirmation p strong {
    color: #000;
    font-weight: bold;
}

/* Warning messages in red */
.custom-confirmation p strong.warning {
    color: #d9534f;
}

/* Final recommendation in orange */
.custom-confirmation p.final-recommendation strong {
    color: #ff9900;
    font-size: 20px;
}

/* Add spacing between sections */
.custom-confirmation hr {
    border: none;
    height: 1px;
    background: #ddd;
    margin: 25px 0;
}

/* Make sure content doesn't feel squeezed */
@media (max-width: 768px) {
    .custom-confirmation {
        padding: 30px 5%;
    }

    .custom-confirmation h2 {
        font-size: 24px;
    }

    .custom-confirmation h3 {
        font-size: 20px;
    }

    .custom-confirmation p {
        font-size: 16px;
    }
}/* End custom CSS */