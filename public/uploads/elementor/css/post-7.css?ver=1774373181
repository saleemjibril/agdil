/* Styling for active tab text and underline */
.jet-radio-list__input:checked + .jet-radio-list__button .jet-radio-list__label {
    font-weight: bold; /* Make the text bold */
    font-size: 16px; /* Adjust font size if needed */
    color: #000; /* Ensure the text color is correct */
    position: relative; /* Needed for the underline */
    text-decoration: none; /* Remove any default underline */
}

/* Default (desktop) underline */
.jet-radio-list__input:checked + .jet-radio-list__button .jet-radio-list__label::after {
    content: "";
    position: absolute;
    width: calc(100% + 10px);
    height: 4px;
    background-color: #34A203;
    left: -5px;
    bottom: -25px; /* Keep big gap on desktop */
    border-radius: 5px;
}

/* Mobile & Tablet: reduce gap */
@media (max-width: 1024px) {
    .jet-radio-list__input:checked + .jet-radio-list__button .jet-radio-list__label::after {
        bottom: -8px; /* Smaller gap for tighter spacing */
    }
}

/* Gravity Forms: Overall Form Container */
#gform_wrapper_1 {
  background: #f9f9f9; /* Light background */
  padding: 20px;
  border-radius: 8px; /* Rounded corners */
  box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1); /* Subtle shadow */
  font-family: 'Arial', sans-serif; /* Clean font style */
}

/* Form Fields (Input, Textarea, Dropdown) */
#gform_wrapper_1 input[type="text"],
#gform_wrapper_1 input[type="email"],
#gform_wrapper_1 input[type="url"],
#gform_wrapper_1 select,
#gform_wrapper_1 textarea {
  width: 100%; /* Full width */
  padding: 10px 15px;
  margin-bottom: 15px; /* Spacing between fields */
  font-size: 16px;
  border: 1px solid #ccc; /* Neutral border */
  border-radius: 4px; /* Smooth edges */
  transition: all 0.3s ease; /* Smooth focus effect */
}

/* Input Field Focus State */
#gform_wrapper_1 input[type="text"]:focus,
#gform_wrapper_1 input[type="email"]:focus,
#gform_wrapper_1 textarea:focus {
  border-color: #0054A6; /* Blue border on focus */
  outline: none; /* Remove default outline */
  box-shadow: 0 0 6px rgba(0, 84, 166, 0.2); /* Glow effect */
}

/* Labels */
#gform_wrapper_1 .gfield_label {
  font-weight: bold;
  font-size: 14px;
  margin-bottom: 5px;
  display: block;
  color: #333; /* Dark gray for visibility */
}

/* Submit Button */
#gform_wrapper_1 .gform_footer input[type="submit"] {
  background: linear-gradient(90deg, #34a203, #34a203); /* Gradient styling */
  color: #fff; /* White text */
  border: none;
  padding: 12px 20px;
  font-size: 16px;
  font-weight: bold;
  text-transform: uppercase;
  border-radius: 5px; /* Smooth button edges */
  cursor: pointer;
  transition: all 0.3s ease; /* Smooth hover effect */
}

/* Submit Button Hover Effect */
#gform_wrapper_1 .gform_footer input[type="submit"]:hover {
  background: linear-gradient(90deg, #34a203, #34a203); /* Reverse gradient */
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2); /* Subtle shadow */
}

/* Error Message Styling */
#gform_wrapper_1 .gfield_error {
  color: #FF0000; /* Red for errors */
  font-size: 14px;
  margin-top: 5px;
}

/* Success Message Styling */
#gform_confirmation_wrapper_1 {
  background: #e6ffe6; /* Light green background */
  color: #2d862d; /* Dark green text */
  padding: 15px;
  border-radius: 5px;
  text-align: center;
}

/* Checkbox and Radio Button Styling */
#gform_wrapper_1 input[type="checkbox"] + label,
#gform_wrapper_1 input[type="radio"] + label {
  font-size: 14px;
  color: #333;
  margin-left: 10px;
}

/* Adjust Padding for Radio/Checkbox Fields */
#gform_wrapper_1 .gfield_checkbox,
#gform_wrapper_1 .gfield_radio {
  margin-bottom: 20px;
}

/* Form Titles */
#gform_wrapper_1 h3.gform_title {
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20px;
  color: #0054A6;
}

